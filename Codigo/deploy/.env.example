# Modelo do .env da VM (docker-compose.prod.yml). Só os nomes: os valores reais
# são gerados por ./deploy/preparar.sh e NUNCA vão para o repositório.
# Explicação de cada variável: Entregável 2, seção 3.3.2.

DOMINIO=seu-subdominio.duckdns.org
SENHA_BANCO=
CHAVE_API=
# chave pública do painel de demonstração; deixar vazia/revogar após a banca
CHAVE_DEMO=
SENHA_MQTT_SERVICO=
# senha do nó BANCADA-01 (copiada para o segredos.h do firmware)
SENHA_MQTT_NO=
# frota simulada (perfil bairro); gerada por deploy/novo_no.sh FROTA-SIM
SENHA_MQTT_FROTA=
ORIGENS_PAINEL=https://seu-painel.vercel.app
# 1 liga o "forçar evento imediato" do painel (só demonstração); vazio = desligado
MODO_TESTE=
CICLO_NOITE_MIN=60
