__pycache__/
.venv/
*.pyc
.pytest_cache/
# Saidas sinteticas do modo --simulada: nunca versionar
*_SIMULADA*
# Serie de Melbourne: baixada por modelo/baixar_dados.py, fora do git
modelo/dados/*.csv
# Relatorios da suite: gerados por cenarios/executar.py
cenarios/resultados/*.json
# Logs dos servicos locais (subir.sh)
.logs/
# Segredos do no (Wi-Fi e credencial do broker): nunca versionar
firmware/no/segredos.h
# Chave da API da VM para a conferencia de bancada (bancada/destino.py)
bancada/chave_vm.txt
# Senha do no simulado SIMULADO-02 no broker da VM (CT20)
simulador/senha_simulado02.txt
# Backups do banco (podem ter dados de bancada): fora do git
backups/
# Implantacao: segredos gerados por deploy/preparar.sh
.env
deploy/broker/passwd
deploy/broker/certs/
# Certificado da CA baixado da VM (cada VM gera o seu)
ca_vm.crt
modelo/dados/*.parquet
